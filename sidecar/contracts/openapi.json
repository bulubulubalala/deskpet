{
  "components": {
    "schemas": {
      "ErrorEnvelope": {
        "description": "边界上的失败信封：code / message 给日志排查，user_hint 给用户看（CODE_STYLE §6）。",
        "properties": {
          "code": {
            "examples": [
              "DP-SYS-501"
            ],
            "pattern": "^DP-(LLM|ASR|TTS|MEM|SCR|DEV|STAGE|PACK|SYS)-[0-9]{3}$",
            "title": "Code",
            "type": "string"
          },
          "message": {
            "description": "机器可读的详情，可含技术细节",
            "title": "Message",
            "type": "string"
          },
          "user_hint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "给用户看的文案；None 表示无需打扰用户",
            "title": "User Hint"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "GpuUsage": {
        "description": "sidecar 自己占用的显存（MB）；探测不到设备时 total_mb 为 None。",
        "properties": {
          "loaded_mb": {
            "default": 0,
            "minimum": 0.0,
            "title": "Loaded Mb",
            "type": "integer"
          },
          "total_mb": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total Mb"
          }
        },
        "title": "GpuUsage",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "description": "GET /health 的响应体；必须 ≤10ms 返回、不加载模型、不抢 GPU 锁（需求 §6.3）。",
        "properties": {
          "gpu": {
            "$ref": "#/components/schemas/GpuUsage"
          },
          "modules": {
            "items": {
              "$ref": "#/components/schemas/ModuleHealth"
            },
            "title": "Modules",
            "type": "array"
          },
          "status": {
            "default": "ok",
            "enum": [
              "ok",
              "degraded",
              "starting"
            ],
            "title": "Status",
            "type": "string"
          },
          "uptime_s": {
            "description": "sidecar 进程已运行秒数",
            "minimum": 0.0,
            "title": "Uptime S",
            "type": "number"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "uptime_s",
          "modules",
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "ModuleHealth": {
        "description": "单个模块的心跳条目；detail 只写短状态描述，禁止放敏感内容（CODE_STYLE §6）。",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "name": {
            "$ref": "#/components/schemas/ModuleName"
          },
          "state": {
            "$ref": "#/components/schemas/ModuleState"
          }
        },
        "required": [
          "name",
          "state"
        ],
        "title": "ModuleHealth",
        "type": "object"
      },
      "ModuleName": {
        "description": "会被心跳观察的模块名（与 app/main/ipc.ts 的 MODULE_NAMES 对齐）。",
        "enum": [
          "tts",
          "asr",
          "llm",
          "memory",
          "screen",
          "stage"
        ],
        "title": "ModuleName",
        "type": "string"
      },
      "ModuleState": {
        "description": "模块状态；offline 由主进程判定（心跳连续失败），sidecar 内部一般不自己置 offline。",
        "enum": [
          "idle",
          "loading",
          "ready",
          "error",
          "offline"
        ],
        "title": "ModuleState",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
