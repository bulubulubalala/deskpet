{
  "components": {
    "schemas": {
      "AsrResponse": {
        "description": "识别结果；confidence 为 0 时上层按「没听清」处理（需求 §6.7）。",
        "properties": {
          "confidence": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "duration_s": {
            "minimum": 0.0,
            "title": "Duration S",
            "type": "number"
          },
          "language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Language"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text",
          "confidence",
          "duration_s"
        ],
        "title": "AsrResponse",
        "type": "object"
      },
      "ChatStreamRequest": {
        "description": "POST /chat/stream 的请求体；响应是 SSE（§6.2 的逐行 JSON 事件）。",
        "properties": {
          "char_id": {
            "title": "Char Id",
            "type": "string"
          },
          "client_ts": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Client Ts"
          },
          "input_mode": {
            "default": "text",
            "enum": [
              "text",
              "voice"
            ],
            "title": "Input Mode",
            "type": "string"
          },
          "screen_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "屏幕 OCR 文本；按不可信输入处理（需求 §7.4）",
            "title": "Screen Text"
          },
          "session_id": {
            "title": "Session Id",
            "type": "string"
          },
          "text": {
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "session_id",
          "char_id",
          "text"
        ],
        "title": "ChatStreamRequest",
        "type": "object"
      },
      "ErrorEnvelope": {
        "description": "边界上的失败信封：code / message 给日志排查，user_hint 给用户看（CODE_STYLE §6）。",
        "properties": {
          "code": {
            "examples": [
              "DP-SYS-501"
            ],
            "pattern": "^DP-(LLM|ASR|TTS|MEM|SCR|DEV|STAGE|PACK|SYS)-[0-9]{3}$",
            "title": "Code",
            "type": "string"
          },
          "message": {
            "description": "机器可读的详情，可含技术细节",
            "title": "Message",
            "type": "string"
          },
          "user_hint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "给用户看的文案；None 表示无需打扰用户",
            "title": "User Hint"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "description": "GET /health 的响应体；必须 ≤10ms 返回、不加载模型、不碰引擎与显存（需求 §6.3）。",
        "properties": {
          "modules": {
            "items": {
              "$ref": "#/components/schemas/ModuleHealth"
            },
            "title": "Modules",
            "type": "array"
          },
          "providers": {
            "description": "三个能力面的供给选择（§6.13 / D19）",
            "items": {
              "$ref": "#/components/schemas/ProviderHealth"
            },
            "title": "Providers",
            "type": "array"
          },
          "status": {
            "default": "ok",
            "enum": [
              "ok",
              "degraded",
              "starting"
            ],
            "title": "Status",
            "type": "string"
          },
          "uptime_s": {
            "description": "sidecar 进程已运行秒数",
            "minimum": 0.0,
            "title": "Uptime S",
            "type": "number"
          },
          "version": {
            "title": "Version",
            "type": "string"
          },
          "voice": {
            "default": "idle",
            "description": "语音状态机状态（sidecar 视角，F2 / T1.6）",
            "enum": [
              "idle",
              "listening",
              "thinking",
              "speaking",
              "cancelling"
            ],
            "title": "Voice",
            "type": "string"
          }
        },
        "required": [
          "uptime_s",
          "modules",
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "MemoryClearRequest": {
        "description": "清空一个角色的记忆；keep_days 给了就只清更早的（隐私要求，§5 F3）。",
        "properties": {
          "char_id": {
            "title": "Char Id",
            "type": "string"
          },
          "keep_days": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Keep Days"
          }
        },
        "required": [
          "char_id"
        ],
        "title": "MemoryClearRequest",
        "type": "object"
      },
      "MemoryClearResponse": {
        "description": "deleted 是实际删除的记忆条数（不含历史消息与摘要）。",
        "properties": {
          "deleted": {
            "minimum": 0.0,
            "title": "Deleted",
            "type": "integer"
          }
        },
        "required": [
          "deleted"
        ],
        "title": "MemoryClearResponse",
        "type": "object"
      },
      "MemoryDeleteResponse": {
        "description": "deleted=False 表示该 id 不存在（幂等，不报错）。",
        "properties": {
          "deleted": {
            "title": "Deleted",
            "type": "boolean"
          }
        },
        "required": [
          "deleted"
        ],
        "title": "MemoryDeleteResponse",
        "type": "object"
      },
      "MemoryHit": {
        "description": "一条检索结果；score 已含重要度与时间衰减（需求 §6.4）。",
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "importance": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Importance",
            "type": "number"
          },
          "occurred_at": {
            "title": "Occurred At",
            "type": "string"
          },
          "score": {
            "title": "Score",
            "type": "number"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "id",
          "text",
          "importance",
          "occurred_at",
          "score"
        ],
        "title": "MemoryHit",
        "type": "object"
      },
      "MemoryListItem": {
        "description": "管理界面里的一条记忆（T2.1a 新增；不含内部去重键与数据库主键细节）。\n\nkind / tier 是普通字符串而不是 Literal：库里允许历史遗留值，响应不该因此 500。",
        "properties": {
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "importance": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Importance",
            "type": "number"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "last_used_at": {
            "title": "Last Used At",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "tier": {
            "title": "Tier",
            "type": "string"
          },
          "used_count": {
            "minimum": 0.0,
            "title": "Used Count",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "kind",
          "tier",
          "text",
          "importance",
          "created_at",
          "last_used_at",
          "used_count"
        ],
        "title": "MemoryListItem",
        "type": "object"
      },
      "MemoryListResponse": {
        "description": "一个角色的记忆列表，按重要度、时间倒序。",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/MemoryListItem"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "MemoryListResponse",
        "type": "object"
      },
      "MemorySearchResponse": {
        "description": "检索结果列表，按 score 降序。",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/MemoryHit"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "MemorySearchResponse",
        "type": "object"
      },
      "MemoryWriteRequest": {
        "description": "写入一条记忆；dedup 由 services 层负责（需求 §6.3）。",
        "properties": {
          "char_id": {
            "title": "Char Id",
            "type": "string"
          },
          "importance": {
            "default": 0.5,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Importance",
            "type": "number"
          },
          "kind": {
            "enum": [
              "fact",
              "preference",
              "event"
            ],
            "title": "Kind",
            "type": "string"
          },
          "occurred_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Occurred At"
          },
          "source": {
            "default": "chat",
            "enum": [
              "chat",
              "user",
              "system"
            ],
            "title": "Source",
            "type": "string"
          },
          "text": {
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "char_id",
          "kind",
          "text"
        ],
        "title": "MemoryWriteRequest",
        "type": "object"
      },
      "MemoryWriteResponse": {
        "description": "deduped=True 表示命中已有记忆，没有新增行。",
        "properties": {
          "deduped": {
            "title": "Deduped",
            "type": "boolean"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "deduped"
        ],
        "title": "MemoryWriteResponse",
        "type": "object"
      },
      "ModuleHealth": {
        "description": "单个模块的心跳条目；detail 只写短状态描述，禁止放敏感内容（CODE_STYLE §6）。",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "name": {
            "$ref": "#/components/schemas/ModuleName"
          },
          "state": {
            "$ref": "#/components/schemas/ModuleState"
          }
        },
        "required": [
          "name",
          "state"
        ],
        "title": "ModuleHealth",
        "type": "object"
      },
      "ModuleName": {
        "description": "会被心跳观察的模块名（与 app/main/ipc.ts 的 MODULE_NAMES 对齐）。",
        "enum": [
          "tts",
          "asr",
          "llm",
          "memory",
          "screen",
          "stage"
        ],
        "title": "ModuleName",
        "type": "string"
      },
      "ModuleState": {
        "description": "模块状态；offline 由主进程判定（心跳连续失败），sidecar 内部一般不自己置 offline。",
        "enum": [
          "idle",
          "loading",
          "ready",
          "error",
          "offline"
        ],
        "title": "ModuleState",
        "type": "string"
      },
      "ProviderHealth": {
        "description": "一个能力面当前选用的供给（§6.13）；detail 只写模型名之类的短描述，绝不放密钥。",
        "properties": {
          "capability": {
            "enum": [
              "llm",
              "asr",
              "tts"
            ],
            "title": "Capability",
            "type": "string"
          },
          "configured": {
            "title": "Configured",
            "type": "boolean"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "capability",
          "name",
          "configured"
        ],
        "title": "ProviderHealth",
        "type": "object"
      },
      "ProviderProbeResult": {
        "description": "单个候选端点的探测结论；provider 是候选顺序里的身份（cloud / local / fallback）。",
        "properties": {
          "base_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "探测的端点地址；本地引擎为 None",
            "title": "Base Url"
          },
          "detail": {
            "description": "给人看的短结论；绝不含密钥",
            "title": "Detail",
            "type": "string"
          },
          "elapsed_ms": {
            "description": "探测耗时（毫秒）",
            "minimum": 0.0,
            "title": "Elapsed Ms",
            "type": "integer"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "探测请求用的模型名；无需模型时为 None",
            "title": "Model"
          },
          "ok": {
            "description": "是否可用",
            "title": "Ok",
            "type": "boolean"
          },
          "provider": {
            "description": "端点在候选顺序里的身份：cloud / local / fallback",
            "title": "Provider",
            "type": "string"
          }
        },
        "required": [
          "provider",
          "ok",
          "detail",
          "elapsed_ms"
        ],
        "title": "ProviderProbeResult",
        "type": "object"
      },
      "ProviderTestRequest": {
        "description": "「测试连接」按钮点的是哪一个能力面。",
        "properties": {
          "capability": {
            "description": "要探测的能力面（llm / asr / tts）",
            "enum": [
              "llm",
              "asr",
              "tts"
            ],
            "title": "Capability",
            "type": "string"
          }
        },
        "required": [
          "capability"
        ],
        "title": "ProviderTestRequest",
        "type": "object"
      },
      "ProviderTestResponse": {
        "description": "一次「测试连接」的全部结论：LLM 面可能有多个候选，ASR / TTS 面各一条。",
        "properties": {
          "capability": {
            "enum": [
              "llm",
              "asr",
              "tts"
            ],
            "title": "Capability",
            "type": "string"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/ProviderProbeResult"
            },
            "title": "Results",
            "type": "array"
          }
        },
        "required": [
          "capability",
          "results"
        ],
        "title": "ProviderTestResponse",
        "type": "object"
      },
      "TtsCancelRequest": {
        "description": "取消一次未完成的合成（打断是一等公民，CODE_STYLE §1.7）。",
        "properties": {
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "request_id"
        ],
        "title": "TtsCancelRequest",
        "type": "object"
      },
      "TtsCancelResponse": {
        "description": "cancelled=False 表示该 request_id 已经结束，属于正常情况。",
        "properties": {
          "cancelled": {
            "title": "Cancelled",
            "type": "boolean"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "required": [
          "cancelled"
        ],
        "title": "TtsCancelResponse",
        "type": "object"
      },
      "TtsRequest": {
        "description": "合成请求；单句建议 ≤40 字（events.MAX_SENTENCE_CHARS），超长由上层切分。",
        "properties": {
          "emo_vector": {
            "items": {
              "type": "number"
            },
            "maxItems": 8,
            "minItems": 8,
            "title": "Emo Vector",
            "type": "array"
          },
          "emo_weight": {
            "default": 0.6,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Emo Weight",
            "type": "number"
          },
          "lang": {
            "default": "zh",
            "enum": [
              "zh",
              "ja",
              "en"
            ],
            "title": "Lang",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "speed": {
            "default": 1.0,
            "maximum": 2.0,
            "minimum": 0.5,
            "title": "Speed",
            "type": "number"
          },
          "text": {
            "minLength": 1,
            "title": "Text",
            "type": "string"
          },
          "voice_id": {
            "title": "Voice Id",
            "type": "string"
          }
        },
        "required": [
          "text",
          "voice_id",
          "request_id"
        ],
        "title": "TtsRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "deskpet-sidecar",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/asr": {
      "post": {
        "description": "识别一段录音；空 / 幻听结果以 text=\"\" 返回，不当作错误（需求 §6.7）。",
        "operationId": "asr_asr_post",
        "parameters": [
          {
            "in": "query",
            "name": "sample_rate",
            "required": false,
            "schema": {
              "default": 16000,
              "maximum": 48000,
              "minimum": 8000,
              "title": "Sample Rate",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "lang",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Lang"
            }
          },
          {
            "in": "query",
            "name": "request_id",
            "required": true,
            "schema": {
              "title": "Request Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/octet-stream": {
              "schema": {
                "format": "binary",
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AsrResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "原始 PCM（不依赖 ffmpeg）→ 文本 + 置信度",
        "tags": [
          "asr"
        ]
      }
    },
    "/chat/stream": {
      "post": {
        "description": "流式返回 LLM 事件（§6.2）；请求未配模型时第一个事件就是 ErrorEvent。",
        "operationId": "chat_stream_chat_stream_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatStreamRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              },
              "text/event-stream": {
                "schema": {
                  "properties": {
                    "t": {
                      "enum": [
                        "s",
                        "m",
                        "a",
                        "end",
                        "e"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "t"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "SSE 流：每个 data 段是一个 §6.2 事件，单句 text ≤40 字"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "500": {
            "content": {
