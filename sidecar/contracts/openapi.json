{
  "components": {
    "schemas": {
      "AsrResponse": {
        "description": "识别结果；confidence 为 0 时上层按「没听清」处理（需求 §6.7）。",
        "properties": {
          "confidence": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "duration_s": {
            "minimum": 0.0,
            "title": "Duration S",
            "type": "number"
          },
          "language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Language"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text",
          "confidence",
          "duration_s"
        ],
        "title": "AsrResponse",
        "type": "object"
      },
      "ChatStreamRequest": {
        "description": "POST /chat/stream 的请求体；响应是 SSE（§6.2 的逐行 JSON 事件）。",
        "properties": {
          "char_id": {
            "title": "Char Id",
            "type": "string"
          },
          "client_ts": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Client Ts"
          },
          "input_mode": {
            "default": "text",
            "enum": [
              "text",
              "voice"
            ],
            "title": "Input Mode",
            "type": "string"
          },
          "screen_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "屏幕 OCR 文本；按不可信输入处理（需求 §7.4）",
            "title": "Screen Text"
          },
          "session_id": {
            "title": "Session Id",
            "type": "string"
          },
          "text": {
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "session_id",
          "char_id",
          "text"
        ],
        "title": "ChatStreamRequest",
        "type": "object"
      },
      "ErrorEnvelope": {
        "description": "边界上的失败信封：code / message 给日志排查，user_hint 给用户看（CODE_STYLE §6）。",
        "properties": {
          "code": {
            "examples": [
              "DP-SYS-501"
            ],
            "pattern": "^DP-(LLM|ASR|TTS|MEM|SCR|DEV|STAGE|PACK|SYS)-[0-9]{3}$",
            "title": "Code",
            "type": "string"
          },
          "message": {
            "description": "机器可读的详情，可含技术细节",
            "title": "Message",
            "type": "string"
          },
          "user_hint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "给用户看的文案；None 表示无需打扰用户",
            "title": "User Hint"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "GpuLockRequest": {
        "description": "申请重型推理闸门；timeout_s 内拿不到就返回 granted=False（需求 §4.4）。",
        "properties": {
          "holder": {
            "enum": [
              "tts",
              "asr",
              "image"
            ],
            "title": "Holder",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "timeout_s": {
            "default": 30.0,
            "exclusiveMinimum": 0.0,
            "title": "Timeout S",
            "type": "number"
          }
        },
        "required": [
          "holder",
          "request_id"
        ],
        "title": "GpuLockRequest",
        "type": "object"
      },
      "GpuLockResponse": {
        "description": "granted=False 时 queue_position 表示前面还有几个等待者。",
        "properties": {
          "granted": {
            "title": "Granted",
            "type": "boolean"
          },
          "queue_position": {
            "default": 0,
            "minimum": 0.0,
            "title": "Queue Position",
            "type": "integer"
          },
          "waited_s": {
            "minimum": 0.0,
            "title": "Waited S",
            "type": "number"
          }
        },
        "required": [
          "granted",
          "waited_s"
        ],
        "title": "GpuLockResponse",
        "type": "object"
      },
      "GpuUsage": {
        "description": "sidecar 自己占用的显存（MB）；探测不到设备时 total_mb 为 None。",
        "properties": {
          "loaded_mb": {
            "default": 0,
            "minimum": 0.0,
            "title": "Loaded Mb",
            "type": "integer"
          },
          "total_mb": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total Mb"
          }
        },
        "title": "GpuUsage",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "description": "GET /health 的响应体；必须 ≤10ms 返回、不加载模型、不抢 GPU 锁（需求 §6.3）。",
        "properties": {
          "gpu": {
            "$ref": "#/components/schemas/GpuUsage"
          },
          "modules": {
            "items": {
              "$ref": "#/components/schemas/ModuleHealth"
            },
            "title": "Modules",
            "type": "array"
          },
          "status": {
            "default": "ok",
            "enum": [
              "ok",
              "degraded",
              "starting"
            ],
            "title": "Status",
            "type": "string"
          },
          "uptime_s": {
            "description": "sidecar 进程已运行秒数",
            "minimum": 0.0,
            "title": "Uptime S",
            "type": "number"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "uptime_s",
          "modules",
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "ModuleHealth": {
        "description": "单个模块的心跳条目；detail 只写短状态描述，禁止放敏感内容（CODE_STYLE §6）。",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "name": {
            "$ref": "#/components/schemas/ModuleName"
          },
          "state": {
            "$ref": "#/components/schemas/ModuleState"
          }
        },
        "required": [
          "name",
          "state"
        ],
        "title": "ModuleHealth",
        "type": "object"
      },
      "ModuleName": {
        "description": "会被心跳观察的模块名（与 app/main/ipc.ts 的 MODULE_NAMES 对齐）。",
        "enum": [
          "tts",
          "asr",
          "llm",
          "memory",
          "screen",
          "stage"
        ],
        "title": "ModuleName",
        "type": "string"
      },
      "ModuleState": {
        "description": "模块状态；offline 由主进程判定（心跳连续失败），sidecar 内部一般不自己置 offline。",
        "enum": [
          "idle",
          "loading",
          "ready",
          "error",
          "offline"
        ],
        "title": "ModuleState",
        "type": "string"
      },
      "TtsCancelRequest": {
        "description": "取消一次未完成的合成（打断是一等公民，CODE_STYLE §1.7）。",
        "properties": {
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "request_id"
        ],
        "title": "TtsCancelRequest",
        "type": "object"
      },
      "TtsCancelResponse": {
        "description": "cancelled=False 表示该 request_id 已经结束，属于正常情况。",
        "properties": {
          "cancelled": {
            "title": "Cancelled",
            "type": "boolean"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "required": [
          "cancelled"
        ],
        "title": "TtsCancelResponse",
        "type": "object"
      },
      "TtsRequest": {
        "description": "合成请求；单句建议 ≤40 字（events.MAX_SENTENCE_CHARS），超长由上层切分。",
        "properties": {
          "emo_vector": {
            "items": {
              "type": "number"
            },
            "maxItems": 8,
            "minItems": 8,
            "title": "Emo Vector",
            "type": "array"
          },
          "emo_weight": {
            "default": 0.6,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Emo Weight",
            "type": "number"
          },
          "lang": {
            "default": "zh",
            "enum": [
              "zh",
              "ja",
              "en"
            ],
            "title": "Lang",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "speed": {
            "default": 1.0,
            "maximum": 2.0,
            "minimum": 0.5,
            "title": "Speed",
            "type": "number"
          },
          "text": {
            "minLength": 1,
            "title": "Text",
            "type": "string"
          },
          "voice_id": {
            "title": "Voice Id",
            "type": "string"
          }
        },
        "required": [
          "text",
          "voice_id",
          "request_id"
        ],
        "title": "TtsRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "deskpet-sidecar",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/asr": {
      "post": {
        "description": "识别一段录音；空 / 幻听结果以 text=\"\" 返回，不当作错误（需求 §6.7）。",
        "operationId": "asr_asr_post",
        "parameters": [
          {
            "in": "query",
            "name": "sample_rate",
            "required": false,
            "schema": {
              "default": 16000,
              "maximum": 48000,
              "minimum": 8000,
              "title": "Sample Rate",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "lang",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Lang"
            }
          },
          {
            "in": "query",
            "name": "request_id",
            "required": true,
            "schema": {
              "title": "Request Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/octet-stream": {
              "schema": {
                "format": "binary",
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AsrResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "原始 PCM（不依赖 ffmpeg）→ 文本 + 置信度",
        "tags": [
          "asr"
        ]
      }
    },
    "/chat/stream": {
      "post": {
        "description": "流式返回 LLM 事件（§6.2）；请求未配模型时第一个事件就是 ErrorEvent。",
        "operationId": "chat_stream_chat_stream_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatStreamRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              },
              "text/event-stream": {
                "schema": {
                  "properties": {
                    "t": {
                      "enum": [
                        "s",
                        "m",
                        "a",
                        "end",
                        "e"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "t"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "SSE 流：每个 data 段是一个 §6.2 事件，单句 text ≤40 字"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "会话主入口：SSE 返回 LLM 事件流"
      }
    },
    "/gpu/lock": {
      "post": {
        "description": "M1 桩：推理资源闸门在 T1.8 实现（需求 §4.4）；模型已声明。",
        "operationId": "gpu_lock_stub_gpu_lock_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GpuLockRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GpuLockResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "501": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Not Implemented"
          }
        },
        "summary": "重型推理串行排队（当前仅 TTS）",
        "tags": [
          "stub"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "返回心跳数据；不得加载模型、不得抢 GPU 锁（需求 §6.3）。",
        "operationId": "get_health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "存活、模型加载状态、显存占用",
        "tags": [
          "health"
        ]
      }
    },
    "/memory/search": {
      "get": {
        "description": "M2 桩：记忆检索在 M2 实现（需求 §6.4）。",
        "operationId": "memory_search_stub_memory_search_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "501": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Not Implemented"
          }
        },
        "summary": "记忆检索：全文 + 重要度 + 时间衰减",
        "tags": [
          "stub"
        ]
      }
    },
    "/memory/write": {
      "post": {
        "description": "M2 桩：记忆写入在 M2 实现（需求 §6.4）。",
        "operationId": "memory_write_stub_memory_write_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "501": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Not Implemented"
          }
        },
        "summary": "写入记忆（带去重）",
        "tags": [
          "stub"
        ]
      }
    },
    "/memory/{memory_id}": {
      "delete": {
        "description": "M2 桩：单条删除在 M2 实现（需求 §5 F3 的隐私要求）。",
        "operationId": "memory_delete_stub_memory__memory_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "memory_id",
            "required": true,
            "schema": {
              "title": "Memory Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "501": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Not Implemented"
          }
        },
        "summary": "单条删除（隐私：让用户能要求忘掉某件事）",
        "tags": [
          "stub"
        ]
      }
    },
    "/persona/import": {
      "post": {
        "description": "M2 桩：角色包导入在 M2 实现（需求 §5 F6）。",
        "operationId": "persona_import_stub_persona_import_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "501": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Not Implemented"
          }
        },
        "summary": "导入自有角色包（目录或单个 .zip）→ 体检 + 落地 characters/",
        "tags": [
          "stub"
        ]
      }
    },
    "/screen/capture": {
      "post": {
        "description": "M4 桩：屏幕识别在 M4 实现（需求 §5 F7）。",
        "operationId": "screen_capture_stub_screen_capture_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "501": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Not Implemented"
          }
        },
        "summary": "热键触发截屏 + OCR，返回文本且不落盘",
        "tags": [
          "stub"
        ]
      }
    },
    "/tts": {
      "post": {
        "description": "M1 桩：合成在 T1.5 实现（需求 §6.3 / §6.12）；请求模型已声明。",
        "operationId": "tts_stub_tts_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TtsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              },
              "audio/wav": {}
            },
            "description": "合成后的音频流（T1.5 实现）"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "501": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Not Implemented"
          }
        },
        "summary": "文本 + 情感向量 → 音频流",
        "tags": [
          "stub"
        ]
      }
    },
    "/tts/cancel": {
      "post": {
        "description": "M1 桩：打断能力在 T1.5/T1.6 实现（需求 §5 F2 / §6.12 的取消语义）。",
        "operationId": "tts_cancel_stub_tts_cancel_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TtsCancelRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TtsCancelResponse"
                }
              }
            },
            "description": "Successful Response"
