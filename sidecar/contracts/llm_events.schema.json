{
  "$defs": {
    "ActEvent": {
      "additionalProperties": false,
      "description": "只驱动形象、不说话的动作。",
      "properties": {
        "act": {
          "minLength": 1,
          "title": "Act",
          "type": "string"
        },
        "t": {
          "const": "a",
          "default": "a",
          "title": "T",
          "type": "string"
        },
        "why": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Why"
        }
      },
      "required": [
        "act"
      ],
      "title": "ActEvent",
      "type": "object"
    },
    "EndEvent": {
      "additionalProperties": false,
      "description": "本轮回复结束（SSE 流到此为止）。",
      "properties": {
        "t": {
          "const": "end",
          "default": "end",
          "title": "T",
          "type": "string"
        }
      },
      "title": "EndEvent",
      "type": "object"
    },
    "ErrorEvent": {
      "additionalProperties": false,
      "description": "技术故障的用户提示（§6.7 的 A 级降级需要它）。\n\n为什么不能复用 SentenceEvent：§7.4 / §6.8 要求角色台词与技术提示是两条通道——\n台词归角色演，故障归系统说。把「网络不通」塞进 s 会让角色替系统背锅，也让\n限频与去重规则（F9）无从下手。",
      "properties": {
        "code": {
          "description": "§6.4 错误码，例如 DP-LLM-003",
          "pattern": "^DP-(LLM|ASR|TTS|MEM|SCR|DEV|STAGE|PACK|SYS)-[0-9]{3}$",
          "title": "Code",
          "type": "string"
        },
        "recoverable": {
          "default": true,
          "description": "false 表示重试也救不回来",
          "title": "Recoverable",
          "type": "boolean"
        },
        "t": {
          "const": "e",
          "default": "e",
          "title": "T",
          "type": "string"
        },
        "user_hint": {
          "description": "给用户看的技术提示（不含排查命令）",
          "minLength": 1,
          "title": "User Hint",
          "type": "string"
        }
      },
      "required": [
        "code",
        "user_hint"
      ],
      "title": "ErrorEvent",
      "type": "object"
    },
    "MemoryEvent": {
      "additionalProperties": false,
      "description": "要写进记忆的事实；去重与重要度计算在 M2 落地。",
      "properties": {
        "importance": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Importance",
          "type": "number"
        },
        "kind": {
          "enum": [
            "fact",
            "preference",
            "event"
          ],
          "title": "Kind",
          "type": "string"
        },
        "t": {
          "const": "m",
          "default": "m",
          "title": "T",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "text"
      ],
      "title": "MemoryEvent",
      "type": "object"
    },
    "SentenceEvent": {
      "additionalProperties": false,
      "description": "一句话：逐句播报，并驱动表情与动作。",
      "properties": {
        "act": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Act"
        },
        "emotion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "必须是角色包 emotion_map 里的键",
          "title": "Emotion"
        },
        "i": {
          "default": 0,
          "description": "句子序号，从 0 开始",
          "minimum": 0,
          "title": "I",
          "type": "integer"
        },
        "intensity": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Intensity",
          "type": "number"
        },
        "t": {
          "const": "s",
          "default": "s",
          "title": "T",
          "type": "string"
        },
        "text": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "SentenceEvent",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "a": "#/$defs/ActEvent",
      "e": "#/$defs/ErrorEvent",
      "end": "#/$defs/EndEvent",
      "m": "#/$defs/MemoryEvent",
      "s": "#/$defs/SentenceEvent"
    },
    "propertyName": "t"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/SentenceEvent"
    },
    {
      "$ref": "#/$defs/MemoryEvent"
    },
    {
      "$ref": "#/$defs/ActEvent"
    },
    {
      "$ref": "#/$defs/EndEvent"
    },
    {
      "$ref": "#/$defs/ErrorEvent"
    }
  ]
}
