# deskpet 环境变量示例：复制为 .env 后填写（.env 已被 .gitignore 忽略）
# LLM（OpenAI 兼容，D2）
# 模型供给层（§6.13 / D19）：每个能力面选 cloud 或 local，选了谁就用谁的端点。
# 缺省即现状：LLM 云端、ASR / TTS 本地。写错立刻报错，不会静默回落。
DESKPET_LLM_PROVIDER=cloud
DESKPET_LLM_BASE_URL=https://api.openai.com/v1
DESKPET_LLM_API_KEY=
DESKPET_LLM_MODEL=
# provider=local 时用这三个键（本地 OpenAI 兼容服务由你自己跑，如 Ollama / LM Studio / llama.cpp）
DESKPET_LLM_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
DESKPET_LLM_LOCAL_API_KEY=
DESKPET_LLM_LOCAL_MODEL=
# 备用端点（§6.7 第二层降级）；留空 = 不启用，模型名留空则沿用主端点的模型
DESKPET_LLM_FALLBACK_BASE_URL=
DESKPET_LLM_FALLBACK_MODEL=
# 首 token 20s、整体 60s、退避重试 1s / 3s（需求 §6.7）
DESKPET_LLM_FIRST_TOKEN_TIMEOUT_S=20
DESKPET_LLM_TOTAL_TIMEOUT_S=60
DESKPET_LLM_RETRY_DELAYS_S=1,3
# 本地 ASR（faster-whisper，D4：CPU + int8，不与 TTS 抢显存）
DESKPET_ASR_PROVIDER=local
DESKPET_ASR_MODEL=small
DESKPET_ASR_DEVICE=cpu
DESKPET_ASR_COMPUTE_TYPE=int8
# 模型缓存目录；留空 = <数据目录>/models/asr。模型不进安装包，首次识别时下载（约 460MB）
DESKPET_ASR_MODEL_DIR=
# 识别语言，留空 = 自动判断（也能填 zh / en / ja）
DESKPET_ASR_LANGUAGE=
DESKPET_ASR_BEAM_SIZE=1
# 单次识别超时（秒），需求 §6.7
DESKPET_ASR_TIMEOUT_S=15
# 静音检测；关掉会把噪声也送去识别
DESKPET_ASR_VAD=true
# 下载镜像；国内下不动模型时设成 https://hf-mirror.com（会自动设 HF_HUB_DISABLE_XET=1）
DESKPET_ASR_HF_ENDPOINT=

# TTS：常驻 IndexTTS 适配器（由用户自己部署并维护，本项目只调用它；需求 §6.12 / D14）
# 适配器入口示例：D:\IndexTTS\.venv\Scripts\python.exe -m tools.indextts_adapter
# 云端识别 / 合成尚未实现（T1.14 后置）：配成 cloud 会明确报未实现，不会静默降级
DESKPET_TTS_PROVIDER=local
DESKPET_TTS_URL=http://127.0.0.1:8742
# 适配器的共享口令；留空 = 不校验（只监听回环时的默认姿势）
DESKPET_TTS_TOKEN=
# 单句合成预算（秒）；超时只跳过这一句，需求 §6.7
DESKPET_TTS_TIMEOUT_S=30
# sidecar（只监听本机回环）
DESKPET_SIDECAR_HOST=127.0.0.1
# 首选端口；被占用时 sidecar 会自动换端口，真实端口写在 data/runtime.json（§6.10）
DESKPET_SIDECAR_PORT=8737
# 运行时数据目录（runtime.json、记忆库等）；留空 = 仓库根 data/
DESKPET_DATA_DIR=
# 角色包目录；留空 = 源码态用仓库根 characters/，打包态用 sidecar.exe 旁边的 characters/
DESKPET_CHARACTERS_DIR=
# 日志级别：debug | info | warn | error
DESKPET_LOG_LEVEL=info
# 日志：单文件上限（字节）与历史保留天数，需求 §6.7 要求 7 天 / 20MB
# 日志固定写在 <数据目录>/logs/deskpet.log（单行 JSON，便于排查）
DESKPET_LOG_MAX_BYTES=20971520
DESKPET_LOG_RETENTION_DAYS=7

# 记忆系统（F3 / §6.4 / §6.5，T2.1a / T2.1b）：留空即用默认值；记忆库 = <数据目录>/memories.db（SQLCipher 整库加密），
# 主密钥 = <数据目录>/key.blob（经 Windows DPAPI 托管，换用户 / 换机器解不开时会明确报 DP-MEM-001）
# 每轮装配带几轮原文、检索几条 L0 片段
DESKPET_MEMORY_HISTORY_TURNS=6
DESKPET_MEMORY_RECALL_LIMIT=8
# 四层与检索的 token 预算（L3 / L2 / L1 / L0 / 历史）
DESKPET_MEMORY_L3_BUDGET_TOKENS=200
DESKPET_MEMORY_L2_BUDGET_TOKENS=300
DESKPET_MEMORY_L1_BUDGET_TOKENS=200
DESKPET_MEMORY_RECALL_BUDGET_TOKENS=400
DESKPET_MEMORY_HISTORY_BUDGET_TOKENS=1200
# 摘要触发阈值与阶梯压缩批量（T2.1b）：条数或 token 任一越线就压；单次最多吃 BATCH 条消息；L2 至少聚 L1_AGGREGATE 条 L1、L3 至少聚 L2_AGGREGATE 条 L2
DESKPET_MEMORY_SUMMARY_TRIGGER_MESSAGES=40
DESKPET_MEMORY_SUMMARY_TRIGGER_TOKENS=2000
DESKPET_MEMORY_SUMMARY_BATCH_MESSAGES=80
DESKPET_MEMORY_L1_AGGREGATE_SUMMARIES=3
DESKPET_MEMORY_L2_AGGREGATE_SUMMARIES=3
DESKPET_MEMORY_EPISODE_LIMIT=5
DESKPET_MEMORY_IMPRESSION_MESSAGES=200
# 记忆时间衰减半衰期（天）
DESKPET_MEMORY_DECAY_HALF_LIFE_DAYS=30
